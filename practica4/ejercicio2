{Bienvenidos al entorno CMRE.
Lo siguiente es un código de ejemplo que implementa un
proceso que recibe un número de avenida como parámetro,
se posiciona en esa avenida y la recorre.}

programa ejemplo
procesos
  proceso juntarPapeles(ES papeles: numero)
  comenzar
    mientras ((HayPapelEnLaEsquina) & (papeles <> 5))
      tomarPapel
      papeles:= papeles + 1
  fin
  proceso acumuladorPap(ES papActuales: numero; E avInicio: numero; E caActual: numero)
  comenzar
    mientras HayPapelEnLaEsquina
      juntarPapeles(papActuales)
      si (papActuales = 5)
        papActuales:=0
        BloquearEsquina(50,50)
        Pos(50,50)
        repetir 5
          depositarPapel
        Pos(avInicio, caActual)
        LiberarEsquina(50,50)
  fin
areas
  esquinaComun: AreaC(50,50,50,50)
  areaR1: AreaP(5,1,5,100)
  areaR2: AreaP(10,1,10,100)
  areaR1Consumidor: AreaP(11,1,11,1)
  areaR2Consumidor: AreaP(12,1,12,1)
robots
  robot robotConsumidor
  variables
    cont: numero
    numRandom: numero
    papActual: numero
    avInicio: numero
    caInicio: numero
  comenzar
    avInicio:= PosAv
    caInicio:= PosCa
    cont:= 0
    mientras cont <> 8
      Random(numRandom, 2,5)
      papActual:= 0
      BloquearEsquina(50,50)
      Pos(50,50)
      mientras ((HayPapelEnLaEsquina) & (papActual <> numRandom))
        tomarPapel
        papActual:= papActual + 1
      si papActual < numRandom
        cont:= cont + 1
        repetir papActual 
          depositarPapel
      sino 
        cont:= 0
      Pos(avInicio, caInicio)
      LiberarEsquina(50,50)
      si HayPapelEnLaBolsa
        repetir papActual
          depositarPapel     
  fin
  robot robotProductor
  variables
    papActuales:numero
    avInicio: numero
    caActual: numero
  comenzar
    papActuales:= 0
    avInicio:= PosAv
    mientras PosCa < 100 
      caActual:= PosCa
      acumuladorPap(papActuales, avInicio, caActual)
      mover
    acumuladorPap(papActuales,avInicio,caActual)    
  fin
variables
  r1: robotProductor
  r2: robotProductor
  r1Consumidor: robotConsumidor
  r2Consumidor: robotConsumidor
comenzar
  AsignarArea(r1, esquinaComun)
  AsignarArea(r2,esquinaComun)
  AsignarArea(r1Consumidor,esquinaComun)
  AsignarArea(r2Consumidor, esquinaComun)
  AsignarArea(r1, areaR1)
  AsignarArea(r2,areaR2)
  AsignarArea(r1Consumidor,areaR1Consumidor)
  AsignarArea(r2Consumidor, areaR2Consumidor)
  Iniciar(r1, 5,1)
  Iniciar(r2, 10,1)
  Iniciar(r1Consumidor, 11,1)
  Iniciar(r2Consumidor, 12,1)
fin