
programa ejercicio3
procesos
  proceso tomarYEvaluar(ES flores: numero; ES todaviaHay: boolean)
  comenzar
    si HayFlorEnLaEsquina
      tomarFlor
      flores:= flores + 1
    sino
      todaviaHay:= F
  fin
areas
  ciudadRobots: AreaPC (2,2,10,10)
  areaJefe: AreaP (1,1,1,1)
  areaR1: AreaP (2,1,2,1)
  areaR2: AreaP (3,1,3,1)
  areaR3: AreaP (4,1,4,1)
  areaR4: AreaP (5,1,5,1)
robots
  robot robotJuntador
  variables
    id: numero
    avInicio: numero
    caInicio: numero
    todaviaHay: boolean
    av: numero
    ca: numero
    flores: numero
  comenzar
    avInicio:= PosAv
    caInicio:= PosCa
    flores:= 0
    todaviaHay:= V
    RecibirMensaje(id, rJefe)
    RecibirMensaje(av, rJefe)
    RecibirMensaje(ca,rJefe)
    mientras todaviaHay
      BloquearEsquina(av, ca)
      Pos(av, ca)
      tomarYEvaluar(flores, todaviaHay)
      Pos(avInicio, caInicio)
      LiberarEsquina(av,ca)
    EnviarMensaje(id, rJefe)
    EnviarMensaje(flores, rJefe)
  fin
  robot robotJefe
  variables
    avRandom: numero
    caRandom: numero
    id: numero
    totalFlo: numero
    robotMax: numero
    max: numero
  comenzar
    EnviarMensaje(1, r1)
    EnviarMensaje(2,r2)
    EnviarMensaje(3,r3)
    EnviarMensaje(4,r4)
    Random(avRandom, 2,10)
    Random(caRandom, 2,10)
    EnviarMensaje(avRandom, r1)
    EnviarMensaje(caRandom, r1)
    EnviarMensaje(avRandom, r2)
    EnviarMensaje(caRandom, r2)
    EnviarMensaje(avRandom, r3)
    EnviarMensaje(caRandom, r3)
    EnviarMensaje(avRandom, r4)
    EnviarMensaje(caRandom, r4)
    max:= -1
    repetir 4
      RecibirMensaje(id, *)
      si (id = 1)
        RecibirMensaje(totalFlo, r1)
      sino
        si(id = 2)
          RecibirMensaje(totalFlo, r2)
        sino
          si(id = 3)
            RecibirMensaje(totalFlo, r3)
          sino 
            RecibirMensaje(totalFlo,r4)
      
      si (totalFlo > max)
        max:= totalFlo
        robotMax:= id
    Informar(robotMax)    
  fin
variables
  rJefe: robotJefe
  r1: robotJuntador
  r2: robotJuntador
  r3: robotJuntador
  r4: robotJuntador
comenzar
  AsignarArea(rJefe, areaJefe)
  AsignarArea(r1, ciudadRobots)
  AsignarArea(r1, areaR1)
  AsignarArea(r2, ciudadRobots)
  AsignarArea(r2, areaR2)
  AsignarArea(r3, ciudadRobots)
  AsignarArea(r3, areaR3)
  AsignarArea(r4, ciudadRobots)
  AsignarArea(r4, areaR4)  
  Iniciar(rJefe, 1,1)
  Iniciar(r1, 2,1)
  Iniciar(r2, 3,1)
  Iniciar(r3, 4,1)
  Iniciar(r4, 5,1)
  
fin